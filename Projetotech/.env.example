# Variáveis de Ambiente - EventosBSB

## Servidor
NODE_ENV=development
PORT=3000

## APIs Externas

# EventBrite API
# Obtenha em: https://www.eventbrite.com/platform/api/
EVENTBRITE_API_KEY=seu_token_eventbrite_aqui

# Google Calendar API
# Obtenha em: https://developers.google.com/calendar
GOOGLE_CALENDAR_API_KEY=sua_chave_google_calendar_aqui

# Portal Gov.br
# Obtenha em: https://dados.gov.br/api-docs
GOVBR_API_KEY=sua_chave_govbr_aqui

## Banco de Dados (Futuro)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/eventos_bsb
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/eventos

## Email/Newsletter (Futuro)
# SENDGRID_API_KEY=sua_chave_sendgrid
# SMTP_HOST=smtp.seuhost.com
# SMTP_PORT=587
# SMTP_USER=seu_email@example.com
# SMTP_PASS=sua_senha

## Segurança
# JWT_SECRET=sua_chave_jwt_super_secreta
# CORS_ORIGIN=http://localhost:3000,https://seu-dominio.com

## Logging
# LOG_LEVEL=info
# LOG_FILE=logs/app.log

## Cache
CACHE_TTL=300000

## Limites
RATE_LIMIT=100
RATE_LIMIT_WINDOW=15m
